{
  "name": "matrixos",
  "description": "智轨星云 v3.0 · 高校全域科研工作台与学术数字资产操作系统（18+N 群岛式微站 × 星轨仪器双态合体 × 跨站虫洞协议）",
  "private": true,
  "type": "module",
  "version": "3.0.0-alpha.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "claim": "node scripts/claim.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:quick": "node scripts/gate.mjs --quick",
    "check": "node scripts/verify.mjs",
    "check:specs": "node scripts/validate-specs.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:staged": "node scripts/verify.mjs --staged",
    "sync:labels": "node scripts/sync-labels.mjs",
    "setup": "node scripts/install-hooks.mjs && node scripts/doctor.mjs",
    "setup:hooks": "node scripts/install-hooks.mjs",
    "gen:keys": "node scripts/gen-keys.mjs",
    "build": "node scripts/safe-build.mjs",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "gen:site": "node scripts/gen-site.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build:raw": "turbo run build",
    "gate:full": "node scripts/gate.mjs --full"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.64.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.8",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.2"
  },
  "keywords": [
    "matrixos",
    "research-workbench",
    "academic",
    "microsites",
    "monorepo"
  ],
  "author": "MatrixOS Team",
  "license": "UNLICENSED"
}
