> MatrixOS local development environment
> 复制为 .env.local 后按需修改：cp .env.example .env.local

# ═══════════════════════════════════════════════════════════════
# orbital-hub 微站寻址
# ═══════════════════════════════════════════════════════════════
# 开发期：指向本地 dev server，端口 = 3010 + (站点 id - 1)
NEXT_PUBLIC_MICROSITE_LOCAL_MODE=true

# 生产期：改为下面这行（注释掉 LOCAL_MODE）
# NEXT_PUBLIC_MICROSITE_ORIGIN_TEMPLATE=https://{appId}.matrixos.edu

# 本地端口基数（与 docs/02-engineering/01-dev-setup.md 的约定一致）
NEXT_PUBLIC_MICROSITE_PORT_BASE=3010

# true = 未就位的微站显示占位页；false = 直接嵌真 iframe
NEXT_PUBLIC_MICROSITE_PLACEHOLDER=false

# ═══════════════════════════════════════════════════════════════
# 性能探针阈值（R-T03 / S2-01e）
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_HUB_FPS_FLOOR=45
NEXT_PUBLIC_HUB_MEM_CEILING_MB=800
NEXT_PUBLIC_HUB_LONG_TASK_MS=100

# true = 强制「1 全量 + 2 快照」降级模式（演示用）
NEXT_PUBLIC_HUB_FORCE_SNAPSHOT=false

# ═══════════════════════════════════════════════════════════════
# 后端服务地址
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_BASE=http://localhost:8000
