{
  "name": "@matrixos/microsite-data",
  "version": "0.1.0",
  "private": true,
  "description": "18 微站共享的演示数据与仪器绑定表（确定性、可复现，用于联调与答辩演示）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@matrixos/instrument-ui": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
