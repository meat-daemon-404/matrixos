{
  "description": "MatrixOS 口袋微信小程序伴侣端 —— 项目配置。AppID 为测试号占位，正式联调时替换为微信开放平台下发的真实 AppID。",
  "miniprogramRoot": "miniprogram/",
  "srcMiniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "matrixos-wechat-pocket",
  "libVersion": "3.5.8",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": "mock-server" },
      { "type": "folder", "value": "scripts" },
      { "type": "folder", "value": "types" },
      { "type": "file", "value": "tsconfig.json" },
      { "type": "file", "value": "README.md" },
      { "type": "suffix", "value": ".ts" },
      { "type": "suffix", "value": ".map" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "coverView": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "preloadBackgroundData": false,
    "minified": true,
    "newFeature": true,
    "autoAudits": false,
    "uglifyFileName": true,
    "uploadWithSourceMap": true,
    "useCompilerPlugins": ["typescript"],
    "compileHotReLoad": false,
    "lazyloadPlaceholderEnable": false,
    "useMultiFrameRuntime": true,
    "useApiHook": true,
    "useApiHostProcess": true,
    "showShadowRootInWxmlPanel": true,
    "useStaticServer": false,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "ignoreUploadUnusedFiles": true,
    "checkInvalidKey": true,
    "disableUseStrict": false,
    "useIsolateContext": true,
    "useCompilerModule": true,
    "userConfirmedUseCompilerModuleSwitch": false
  },
