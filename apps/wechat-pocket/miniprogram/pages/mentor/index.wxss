.mt-head { padding: 28rpx 24rpx 8rpx; }
.mt-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--mx-instrument);
}
.mt-next {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mx-text);
  margin-top: 8rpx;
}
.mt-next-dim { color: var(--mx-text-muted); font-weight: 400; }
.mt-synced { display: block; font-size: 20rpx; color: var(--mx-text-muted); margin-top: 10rpx; }
.mt-scroll { padding-bottom: 40rpx; }

.mt-card {
  background: linear-gradient(160deg, var(--mx-panel), var(--mx-panel-end));
  border: 2rpx solid var(--mx-border);
  border-radius: 22rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
}
.mt-card-top { display: flex; align-items: flex-start; gap: 18rpx; }
.mt-name { font-size: 34rpx; font-weight: 600; color: var(--mx-text); }
.mt-title-tag {
  font-size: 20rpx;
  color: var(--mx-text-muted);
  border: 2rpx solid var(--mx-border-strong);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.mt-lab { display: block; font-size: 24rpx; color: var(--mx-text-secondary); margin-top: 6rpx; }
.mt-match {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 16rpx;
  background: var(--mx-sunken);
  border-radius: 14rpx;
  border: 2rpx solid var(--mx-border);
}
.mt-match-num { font-size: 34rpx; font-weight: 700; color: var(--mx-instrument); line-height: 1.1; }
.mt-match-label { font-size: 18rpx; color: var(--mx-text-muted); }

.mt-stage { display: flex; align-items: center; gap: 10rpx; margin-top: 22rpx; }
.mt-stage-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--mx-border);
}
.mt-stage-dot.is-on { background: var(--mx-instrument); }
.mt-stage-text { font-size: 24rpx; color: var(--mx-text-secondary); margin-left: 8rpx; }
.mt-read {
  font-size: 20rpx;
  color: var(--mx-positive);
  border: 2rpx solid rgba(52, 211, 153, 0.4);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.mt-count {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(34, 211, 238, 0.06);
  border-left: 6rpx solid var(--mx-instrument);
  border-radius: 10rpx;
  font-size: 24rpx;
  color: var(--mx-text-secondary);
}
.mt-count.is-urgent {
  background: rgba(251, 191, 36, 0.1);
  border-left-color: var(--mx-warning);
}
.mt-count-glyph { color: var(--mx-instrument); }
.mt-count.is-urgent .mt-count-glyph { color: var(--mx-warning); }
.mt-count-time { flex: none; color: var(--mx-instrument); font-weight: 600; }
.mt-count.is-urgent .mt-count-time { color: var(--mx-warning); }

.mt-anchors { margin-top: 20rpx; padding-top: 16rpx; border-top: 2rpx dashed var(--mx-border); }
.mt-anchors-label { font-size: 20rpx; color: var(--mx-text-muted); display: block; }
.mt-anchor {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}
.mt-anchor-ref {
  font-size: 20rpx;
  color: var(--mx-text-secondary);
  word-break: break-all;
  flex: 1;
  min-width: 0;
}
.mt-anchor-lv {
  flex: none;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.lv-Level_A_Verified { color: var(--mx-positive); background: rgba(52, 211, 153, 0.12); }
.lv-Level_B_Preprint { color: var(--mx-text-muted); background: rgba(148, 163, 184, 0.12); }
.lv-Retracted_Warning { color: var(--mx-danger); background: rgba(251, 113, 133, 0.14); }
.mt-anchor-page { font-size: 18rpx; color: var(--mx-text-muted); flex: none; }

.mt-outline { margin-top: 20rpx; }
.mt-outline-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  background: var(--mx-sunken);
  border-radius: 12rpx;
}
.mt-outline-title { font-size: 24rpx; color: var(--mx-text-secondary); }
.mt-outline-caret { font-size: 20rpx; color: var(--mx-instrument); }
.mt-outline-body { margin-top: 12rpx; }
.mt-outline-page {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--mx-border);
}
.mt-outline-page:last-child { border-bottom: none; }
.mt-outline-num {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: var(--mx-raised);
  color: var(--mx-instrument);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
}
.mt-outline-ptitle { display: block; font-size: 26rpx; color: var(--mx-text); }
.mt-outline-points { display: block; font-size: 22rpx; color: var(--mx-text-muted); margin-top: 4rpx; }

.mt-actions { margin-top: 22rpx; }
.mt-btn { width: 100%; }
.mt-acked { font-size: 22rpx; color: var(--mx-text-muted); }
