.mn-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 24rpx 8rpx;
}
.mn-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--mx-instrument);
}
.mn-date {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--mx-text);
  font-variant-numeric: tabular-nums;
}
.mn-head-r {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
}
.mn-queue {
  position: relative;
  font-size: 24rpx;
  color: var(--mx-text-secondary);
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--mx-border-strong);
  border-radius: 999rpx;
}
.mn-badge {
  margin-left: 8rpx;
  min-width: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--mx-instrument);
  color: var(--mx-obsidian);
  font-size: 20rpx;
  font-weight: 700;
  display: inline-block;
  text-align: center;
}
.mn-scroll { padding-bottom: 40rpx; }
.mn-card {
  background: linear-gradient(160deg, var(--mx-panel), var(--mx-panel-end));
  border: 2rpx solid var(--mx-border);
  border-radius: 22rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
}
.mn-card.is-dismissed { opacity: 0.5; }
.mn-card-top { display: flex; align-items: flex-start; gap: 18rpx; }
.mn-idx {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: var(--mx-sunken);
  border: 2rpx solid var(--mx-border-strong);
  color: var(--mx-instrument);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.mn-src {
  display: block;
  font-size: 22rpx;
  color: var(--mx-text-muted);
  letter-spacing: 1rpx;
}
.mn-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mx-text);
  margin-top: 4rpx;
}
.mn-time { font-size: 20rpx; color: var(--mx-text-muted); flex: none; }
.mn-summary {
  display: block;
  font-size: 26rpx;
  color: var(--mx-text-secondary);
  margin-top: 16rpx;
}
.mn-heat { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.mn-heat-bar { flex: 1; }
.mn-heat-text { font-size: 22rpx; color: var(--mx-text-muted); flex: none; }
.mn-metrics { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.mn-chip {
  display: flex;
  flex-direction: column;
  padding: 10rpx 20rpx;
  background: var(--mx-sunken);
  border-radius: 12rpx;
  border: 2rpx solid var(--mx-border);
}
.mn-chip-label { font-size: 20rpx; color: var(--mx-text-muted); }
.mn-chip-value { font-size: 26rpx; color: var(--mx-instrument); font-weight: 600; }
.mn-fit {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  background: rgba(34, 211, 238, 0.07);
  border-left: 6rpx solid var(--mx-instrument);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--mx-text-secondary);
}
.mn-fit-glyph { color: var(--mx-instrument); }
.mn-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.mn-btn { flex: 1; }
.mn-done-note { margin-top: 24rpx; text-align: center; font-size: 24rpx; color: var(--mx-text-muted); }
.mn-evi {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--mx-border);
}
.mn-evi-label { font-size: 20rpx; color: var(--mx-text-muted); }
.mn-evi-doi { font-size: 20rpx; color: var(--mx-positive); word-break: break-all; }
