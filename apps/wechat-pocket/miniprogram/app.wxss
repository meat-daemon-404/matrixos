/* MatrixOS 口袋端 —— 全局样式
 * 暗色「科研仪器」基调，与 app.json 的 navigationBar / tabBar 配色一致。
 * 仅放跨页复用的原子类，避免业务样式外溢到逻辑层。 */

page {
  background: #050814;
  color: #e2e8f0;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #0b1124;
  border: 1rpx solid #1b2640;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.subtitle {
  font-size: 24rpx;
  color: #94a3b8;
}

.muted {
  color: #64748b;
}

.accent {
  color: #22d3ee;
}

/* 数据新鲜度角标（ADR-09：降级必须显式可见，禁止静默） */
.badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  line-height: 1.6;
}

.badge-demo {
  color: #f59e0b;
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.08);
}

.badge-cache {
  color: #94a3b8;
  border-color: #475569;
  background: rgba(148, 163, 184, 0.08);
}

.badge-live {
  color: #34d399;
  border-color: #34d399;
  background: rgba(52, 211, 153, 0.08);
}

.badge-local {
  color: #38bdf8;
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.08);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  background: #111a30;
  color: #cbd5e1;
  border: 1rpx solid #25324f;
}

.btn-accent {
  background: rgba(34, 211, 238, 0.12);
  color: #22d3ee;
  border-color: rgba(34, 211, 238, 0.4);
}

.btn[disabled] {
  opacity: 0.5;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.metric {
  display: inline-flex;
  flex-direction: column;
  margin-right: 28rpx;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #e2e8f0;
}

.metric-label {
  font-size: 20rpx;
  color: #64748b;
}

.empty {
  text-align: center;
  color: #64748b;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.loading {
  text-align: center;
  color: #64748b;
  padding: 40rpx 0;
  font-size: 26rpx;
}
