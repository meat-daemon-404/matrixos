{
  "name": "@matrixos/instrument-ui",
  "version": "0.5.0",
  "description": "MatrixOS 数字精密科研仪器组件库 — 旋钮族 / 图表族 / 雷达族 / 天平族（React 19 + Tailwind CSS 4 + Vite library mode）",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "tailwind.preset.js",
    "tailwind.preset.cjs",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens.compat.css": "./src/tokens.compat.css",
    "./theme.tailwind4.css": "./src/theme.tailwind4.css",
    "./tailwind.preset.js": "./tailwind.preset.js",
    "./tailwind.preset.cjs": "./tailwind.preset.cjs",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "preview": "vite --config vite.demo.config.ts preview",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/self-test.mjs --package instrument-ui",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  },
  "keywords": [
    "matrixos",
    "instrument-ui",
    "react",
    "design-system",
    "scientific-instrument"
  ]
}
