{
  "name": "@matrixos/sdk",
  "version": "0.1.0",
  "description": "MatrixOS 开放插槽协议 SDK：MatrixID 双通道单点登录、跨站虫洞环（P2P）、资产图谱客户端、插槽清单校验",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "matrixos",
    "sdk",
    "sso",
    "wormhole",
    "micro-frontend",
    "iframe"
  ],
  "license": "UNLICENSED"
}
