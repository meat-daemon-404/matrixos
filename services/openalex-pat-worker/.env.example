# =============================================================================
# openalex-pat-worker 环境变量模板
# 复制为 .env 后填写；.env 已在仓库根 .gitignore 中，禁止提交真实值。
# =============================================================================

# ---- 礼貌池标识（红线：OpenAlex 要求带 mailto，Crossref 要求带 User-Agent）----
# 这两项不是密钥，但属于「你是谁」的联络信息，必须由部署方填写真实邮箱。
# 缺失时服务仍然启动，但会进入 degrade 模式并在 /healthz 标红。
PAT_CONTACT_EMAIL=dev@matrixos.edu

# ---- OpenAlex ----
OPENALEX_BASE_URL=https://api.openalex.org
# 可选 API Key（OpenAlex 目前免费池不需要，机构版才有）。留空即匿名 + mailto 走礼貌池。
OPENALEX_API_KEY=

# ---- arXiv ----
ARXIV_BASE_URL=https://export.arxiv.org/api/query
# arXiv 官方建议两次请求间隔 ≥ 3s
ARXIV_MIN_INTERVAL_SECONDS=3.0

# ---- Crossref ----
CROSSREF_BASE_URL=https://api.crossref.org

# ---- Nature 系列 RSS（Nature Photonics 为 04 站主信源）----
NATURE_RSS_URLS=https://www.nature.com/nphoton.rss,https://www.nature.com/nphys.rss

# ---- 监听范围 ----
# 逗号分隔的 arXiv 分类；物理/光电/天文/材料为 04 站核心学科
PAT_ARXIV_CATEGORIES=cond-mat.mes-hall,cond-mat.mtrl-sci,physics.optics,physics.app-ph,astro-ph.IM,quant-ph
# 逗号分隔的 OpenAlex field id（31=Physics and Astronomy，25=Materials Science）
PAT_OPENALEX_FIELD_IDS=31,25
# 早报回看窗口（小时），默认 24
PAT_WINDOW_HOURS=24
# 时区：早报的 08:00 与 brief_date 都按这个时区解释
PAT_TIMEZONE=Asia/Shanghai
# 每日生成时刻（24h，HH:MM）
PAT_BRIEF_CRON_TIME=08:00

# ---- 服务 ----
PAT_HOST=127.0.0.1
PAT_PORT=8001
PAT_LOG_LEVEL=INFO
# 内部服务令牌：/internal/* 端点要求 Authorization: Bearer <token>。
# 生产必须设置；留空表示「开发模式不校验」，此时 /healthz 会报 degraded。
PAT_INTERNAL_TOKEN=
# 调度器开关（测试与一次性 CLI 里设为 false）
PAT_SCHEDULER_ENABLED=true

# ---- 限速与重试 ----
PAT_HTTP_TIMEOUT_SECONDS=20
PAT_HTTP_MAX_RETRIES=3
PAT_HTTP_BACKOFF_BASE_SECONDS=0.5
PAT_HTTP_CACHE_TTL_SECONDS=900

# ---- 存储 ----
# 默认落 SQLite 文件；测试用 :memory: 或临时目录
PAT_STORE_PATH=./.data/pat-worker.sqlite3
