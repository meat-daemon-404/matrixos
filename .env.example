# ─────────────────────────────────────────────────────────────
# MatrixOS 环境变量模板
#   复制为 .env.local 后填写真实值
#   cp .env.example .env.local
#
# 🔴 红线：.env* 已在 .gitignore 中，任何情况下不得提交真实 Key
# ─────────────────────────────────────────────────────────────

# ═══════════════ 数据库 ═══════════════
# PostgreSQL 16 + pgvector
DATABASE_URL=postgresql+asyncpg://matrixos:matrixos_dev_only@localhost:5432/matrixos

# ═══════════════ MatrixID 鉴权 ═══════════════
# RSA 私钥路径（首次运行 scripts/gen-keys.sh 生成）
MATRIXID_PRIVATE_KEY_PATH=./services/matrix-core/keys/private.pem
MATRIXID_PUBLIC_KEY_PATH=./services/matrix-core/keys/public.pem
# Token 有效期
MATRIXID_ACCESS_TOKEN_TTL=900        # mx_at 15 分钟
MATRIXID_REFRESH_TOKEN_TTL=2592000   # mx_rt 30 天
MATRIXID_IDT_TTL=120                 # mx_idt 120 秒（iframe 一次性交换）

# 允许的跨站来源（虫洞 postMessage 校验）
MATRIXOS_ALLOWED_ORIGINS=https://orbital.matrixos.edu,http://localhost:3000

# ═══════════════ 模型路由 ═══════════════
# TIER 01 · 意图与早报层
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

# TIER 02 · 结构校验与自愈
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FLASH_MODEL=qwen-flash

# TIER 04 · 端侧隐私算力（本地 LoRA，可选）
QWEN_LOCAL_ENDPOINT=http://localhost:11434/v1
QWEN_LOCAL_MODEL=qwen2.5-7b-instruct

# 成本控制
COST_DAILY_LIMIT_CNY=4.2     # 单用户日均（对应 <¥1.5/年 目标）
COST_GLOBAL_DAILY_LIMIT_CNY=100
LLM_CACHE_ENABLED=true

# ═══════════════ 学术数据源 ═══════════════
# OpenAlex 礼貌池标识（填你的邮箱，可提升限速配额）
OPENALEX_MAILTO=
OPENALEX_BASE_URL=https://api.openalex.org
ARXIV_BASE_URL=https://export.arxiv.org/api
CROSSREF_MAILTO=

# ═══════════════ 前端 ═══════════════
NODE_ENV=development
NEXT_PUBLIC_API_BASE=http://localhost:8000
# 微站域名模板，开发期可指向本地
NEXT_PUBLIC_MICROSITE_ORIGIN_TEMPLATE=http://localhost:{port}

# ═══════════════ 微信小程序 ═══════════════
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_WS_URL=ws://localhost:8000/v1/push

# ═══════════════ 可观测性 ═══════════════
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
